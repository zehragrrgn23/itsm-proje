# Bu dosyayı .env olarak kopyalayip degerleri kendinize gore duzenleyin
FLASK_SECRET_KEY=lutfen-bunu-degistirin-guclu-bir-anahtar
FLASK_ENV=development

POSTGRES_DB=itsm
POSTGRES_USER=itsm_user
POSTGRES_PASSWORD=itsm_pass

# docker-compose icinde otomatik set edilir, local (docker disi) calistirmak icin degistirin
DATABASE_URL=postgresql://itsm_user:itsm_pass@localhost:5432/itsm

# Ilk kurulumda otomatik olusturulacak admin kullanicisi
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
